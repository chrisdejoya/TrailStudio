{
  "name": "trailstudio",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node esbuild.config.mjs",
    "test": "node --test",
    "format": "prettier --write \"src/**/*.{js,mjs}\" \"test/**/*.js\" index.html \"css/*.css\" package.json esbuild.config.mjs \"tools/*.cjs\"",
    "format:check": "prettier --check \"src/**/*.{js,mjs}\" \"test/**/*.js\" index.html \"css/*.css\" package.json esbuild.config.mjs \"tools/*.cjs\"",
    "check": "npm run test && npm run build",
    "update-three": "npm install three@latest --save-dev && npm run build"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "prettier": "^3.6.2",
    "three": "^0.185.1"
  }
}
